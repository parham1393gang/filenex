# Copy this file to .env and replace both secret values before starting.
PORT=3000
NODE_ENV=development
# Admin login + upload confirmation code: at least 16 characters.
ADMIN_UPLOAD_CODE=replace-this-with-a-long-random-secret
# Keep this private and at least 32 characters long.
FILE_CODE_SECRET=replace-this-with-another-long-random-secret
# Maximum upload size in megabytes (1-500).
MAX_FILE_MB=100
# All users must enter this code to register.
REGISTRATION_CODE=13931363
